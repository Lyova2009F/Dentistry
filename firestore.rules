rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Primitives
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'l.zoroglyan@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // =========================================================================
    // Entity Validation Blueprints
    // =========================================================================
    function isValidDoctor(data) {
      return data.keys().hasAll([
          'id', 'name', 'role', 'experience', 'cabinet',
          'bio', 'imageUrl', 'availableDays', 'timeSlots', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'role', 'experience', 'cabinet',
          'bio', 'imageUrl', 'availableDays', 'timeSlots', 'dateOverrides', 'updatedAt'
        ])
        && isValidId(data.id) && data.id.size() <= 64
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.role is string && data.role.size() >= 2 && data.role.size() <= 100
        && data.experience is string && data.experience.size() >= 1 && data.experience.size() <= 50
        && data.cabinet is string && data.cabinet.size() >= 1 && data.cabinet.size() <= 40
        && data.bio is string && data.bio.size() >= 2 && data.bio.size() <= 400
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 300
        && data.availableDays is list && data.availableDays.size() >= 1 && data.availableDays.size() <= 7
        && data.availableDays[0] is string
        && data.timeSlots is list && data.timeSlots.size() >= 1 && data.timeSlots.size() <= 20
        && data.timeSlots[0] is string
        && (!('dateOverrides' in data) || (data.dateOverrides is map && data.dateOverrides.size() <= 90))
        && data.updatedAt is timestamp;
    }

    function isValidBookedSlot(data) {
      return data.keys().hasAll(['doctorId', 'date', 'time', 'appointmentId', 'createdAt'])
        && data.keys().hasOnly(['doctorId', 'date', 'time', 'appointmentId', 'createdAt'])
        && isValidId(data.doctorId) && data.doctorId.size() <= 64
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string && data.time.size() == 5 && data.time.matches('^[0-9]{2}:[0-9]{2}$')
        && isValidId(data.appointmentId) && data.appointmentId.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll([
          'firstName', 'lastName', 'phone', 'requestDetails', 'toothZone',
          'doctorId', 'doctorName', 'date', 'time', 'slotId',
          'status', 'telegramSent', 'telegramPreview',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'firstName', 'lastName', 'phone', 'requestDetails', 'toothZone',
          'doctorId', 'doctorName', 'date', 'time', 'slotId',
          'status', 'telegramSent', 'telegramPreview',
          'createdAt', 'updatedAt'
        ])
        && data.firstName is string && data.firstName.size() >= 1 && data.firstName.size() <= 80
        && data.lastName is string && data.lastName.size() >= 1 && data.lastName.size() <= 80
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 32
        && data.phone.matches('^[0-9+\\-()\\s]{6,32}$')
        && data.requestDetails is string && data.requestDetails.size() >= 2 && data.requestDetails.size() <= 600
        && data.toothZone is string && data.toothZone.size() <= 120
        && isValidId(data.doctorId) && data.doctorId.size() <= 64
        && data.doctorName is string && data.doctorName.size() >= 2 && data.doctorName.size() <= 100
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string && data.time.size() == 5 && data.time.matches('^[0-9]{2}:[0-9]{2}$')
        && isValidId(data.slotId) && data.slotId.size() <= 100
        && data.status in ['new', 'confirmed', 'completed', 'cancelled']
        && data.telegramSent is bool
        && data.telegramPreview is string && data.telegramPreview.size() <= 1200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClinicLocation(data) {
      return data.keys().hasAll([
          'name', 'address', 'lat', 'lng', 'workingHoursNote', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'address', 'searchQuery', 'placeId', 'lat', 'lng', 'workingHoursNote', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.address is string && data.address.size() >= 3 && data.address.size() <= 240
        && (!('searchQuery' in data) || (data.searchQuery is string && data.searchQuery.size() <= 200))
        && (!('placeId' in data) || (data.placeId is string && data.placeId.size() <= 160))
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.workingHoursNote is string && data.workingHoursNote.size() <= 160
        && data.updatedAt is timestamp;
    }

    function isValidClinicDisplay(data) {
      return data.keys().hasAll(['mapEnabled', 'updatedAt'])
        && data.keys().hasOnly(['mapEnabled', 'updatedAt'])
        && data.mapEnabled is bool
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    match /doctors/{doctorId} {
      allow get: if isValidId(doctorId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(doctorId)
        && isValidDoctor(incoming())
        && incoming().id == doctorId
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(doctorId)
        && isValidDoctor(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'role', 'experience', 'cabinet', 'bio',
          'imageUrl', 'availableDays', 'timeSlots', 'dateOverrides', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(doctorId);
    }

    match /bookedSlots/{slotId} {
      allow get: if isValidId(slotId);
      allow list: if true;
      allow create: if isValidId(slotId)
        && isValidBookedSlot(incoming())
        && incoming().createdAt == request.time
        && !exists(/databases/$(database)/documents/bookedSlots/$(slotId))
        && existsAfter(/databases/$(database)/documents/appointments/$(incoming().appointmentId));
      allow update: if false;
      allow delete: if isAdmin() && isValidId(slotId);
    }

    match /appointments/{appointmentId} {
      allow get: if isAdmin() && isValidId(appointmentId);
      allow list: if isAdmin();
      allow create: if isValidId(appointmentId)
        && isValidAppointment(incoming())
        && incoming().status == 'new'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/bookedSlots/$(incoming().slotId));
      allow update: if isAdmin()
        && isValidId(appointmentId)
        && isValidAppointment(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'telegramSent', 'telegramPreview', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(appointmentId);
    }

    match /admins/{adminId} {
      allow get: if isAdmin() && isValidId(adminId);
      allow list, create, update, delete: if false;
    }

    match /clinicSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(settingId)
        && isValidClinicLocation(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(settingId)
        && isValidClinicLocation(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'address', 'searchQuery', 'placeId', 'lat', 'lng', 'workingHoursNote', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(settingId);
    }

    match /clinicDisplay/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(settingId)
        && isValidClinicDisplay(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(settingId)
        && isValidClinicDisplay(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['mapEnabled', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(settingId);
    }
  }
}
