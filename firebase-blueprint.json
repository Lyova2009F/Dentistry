{
  "entities": {
    "Doctor": {
      "title": "Doctor",
      "description": "Dental clinic specialist with convenient working days, time slots, and date-specific calendar overrides.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "experience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "cabinet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "bio": {
          "type": "string",
          "minLength": 2,
          "maxLength": 400
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "availableDays": {
          "type": "array",
          "description": "Default weekday keys when the doctor works (mon..sun)"
        },
        "timeSlots": {
          "type": "array",
          "description": "Default HH:MM appointment windows offered by the doctor"
        },
        "dateOverrides": {
          "type": "object",
          "description": "Calendar overrides mapping YYYY-MM-DD to custom HH:MM slot arrays"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "experience",
        "cabinet",
        "bio",
        "imageUrl",
        "availableDays",
        "timeSlots",
        "updatedAt"
      ]
    },
    "BookedSlot": {
      "title": "BookedSlot",
      "description": "Non-PII occupancy lock preventing double-booking a doctor's time window.",
      "type": "object",
      "properties": {
        "doctorId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "time": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "appointmentId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "doctorId",
        "date",
        "time",
        "appointmentId",
        "createdAt"
      ]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Patient dental appointment request, restricted to clinic Boss/Admin.",
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "lastName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "phone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 32,
          "pattern": "^[0-9+\\-()\\s]{6,32}$"
        },
        "requestDetails": {
          "type": "string",
          "minLength": 2,
          "maxLength": 600
        },
        "toothZone": {
          "type": "string",
          "maxLength": 120
        },
        "doctorId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "doctorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "time": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "slotId": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["new", "confirmed", "completed", "cancelled"]
        },
        "telegramSent": {
          "type": "boolean"
        },
        "telegramPreview": {
          "type": "string",
          "maxLength": 1200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "firstName",
        "lastName",
        "phone",
        "requestDetails",
        "toothZone",
        "doctorId",
        "doctorName",
        "date",
        "time",
        "slotId",
        "status",
        "telegramSent",
        "telegramPreview",
        "createdAt",
        "updatedAt"
      ]
    },
    "Admin": {
      "title": "Admin",
      "description": "Clinic Boss/Administrator role document.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["boss"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role", "createdAt"]
    },
    "ClinicLocation": {
      "title": "ClinicLocation",
      "description": "Boss-configured clinic address, coordinates, and working hours shown on Google Maps.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "address": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "searchQuery": {
          "type": "string",
          "maxLength": 200
        },
        "placeId": {
          "type": "string",
          "maxLength": 160
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "workingHoursNote": {
          "type": "string",
          "maxLength": 160
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "address", "lat", "lng", "workingHoursNote", "updatedAt"]
    },
    "ClinicDisplaySettings": {
      "title": "ClinicDisplaySettings",
      "description": "Public display settings managed by clinic Boss (e.g. map visibility on site).",
      "type": "object",
      "properties": {
        "mapEnabled": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["mapEnabled", "updatedAt"]
    }
  },
  "firestore": {
    "/doctors/{doctorId}": {
      "schema": { "$ref": "#/entities/Doctor" },
      "description": "Dental specialists and their calendar schedules"
    },
    "/bookedSlots/{slotId}": {
      "schema": { "$ref": "#/entities/BookedSlot" },
      "description": "Publicly readable non-PII occupied appointment windows"
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Private patient booking requests with PII"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Authorized clinic administrators"
    },
    "/clinicSettings/{settingId}": {
      "schema": { "$ref": "#/entities/ClinicLocation" },
      "description": "Publicly readable, admin-managed clinic location & map settings"
    },
    "/clinicDisplay/{settingId}": {
      "schema": { "$ref": "#/entities/ClinicDisplaySettings" },
      "description": "Publicly readable, admin-managed map visibility settings"
    }
  }
}
